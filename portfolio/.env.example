# ------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.  NEVER commit .env
# ------------------------------------------------------------------

# development | production
APP_ENV=development

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# MySQL connection (database must exist — see database/schema.sql)
DATABASE_URL=mysql+pymysql://portfolio_user:your_db_password@localhost:3306/salem_portfolio?charset=utf8mb4

# Public site address (used for canonical URLs, sitemap, Open Graph)
SITE_URL=http://localhost:5000

# Default interface language for new visitors: ar | en
DEFAULT_LANG=ar

# Admin dashboard path (e.g. "admin" -> /admin). Changing it hides the login page from bots.
ADMIN_URL_PREFIX=admin

# Optional: used by `flask create-admin` as defaults (you will still be prompted)
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Security
SESSION_COOKIE_SECURE=false     # set to true when the site runs on HTTPS
SESSION_LIFETIME_MINUTES=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
CONTACT_MAX_PER_HOUR=5
PROXY_FIX=false                 # true when behind Nginx / a reverse proxy

# Uploads (MB)
MAX_IMAGE_MB=8
MAX_UPLOAD_MB=25

# Optional: e-mail notification for new contact messages
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=
MAIL_NOTIFY_TO=
